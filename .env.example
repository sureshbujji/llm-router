# Copy to .env and fill in when swapping the mock backends for real model APIs.
# The simulation and tests never read this file — everything runs offline.

# Cheap/fast tier API (e.g. a Flash-class model endpoint)
FLASH_API_KEY=your-flash-api-key-here
FLASH_BASE_URL=https://api.example.com/v1
FLASH_MODEL=flash-model-name

# Strong/expensive tier API (e.g. a Pro-class model endpoint)
PRO_API_KEY=your-pro-api-key-here
PRO_BASE_URL=https://api.example.com/v1
PRO_MODEL=pro-model-name
